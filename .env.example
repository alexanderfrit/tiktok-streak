# ==========================================
# Single Account Mode (Simplest Setup)
# ==========================================
TIKTOK_SESSION_ID="your_sessionid_cookie_from_browser"
MESSAGE="🔥 Daily Streak"

# Target Friends: Comma-separated list (alternative to friends.csv)
FRIENDS_LIST="friend_username_1, friend_username_2"

# Video shared as a rich card, sent SHARE_TIMES times after the text.
# Shipped default (used if these are absent); set to "" to disable.
STREAK_VIDEO_URL="https://www.tiktok.com/@yutta/video/7684838545659317524"
SHARE_TIMES=2

# Photo sent as one media card after the text. Shipped default:
# PHOTO_PATH="assets/default_photo.png"  (set to "" to disable)

# Local Browser Visibility: true (headless background) or false (visible window)
HEADLESS=true

# ==========================================
# Notifications (Telegram - Optional)
# ==========================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
