# ==========================================
# Single Account Mode (Simplest Setup)
# ==========================================
TIKTOK_SESSION_ID="your_sessionid_cookie_from_browser"
MESSAGE="🔥 Daily Streak"

# Target Friends: Comma-separated list (alternative to friends.csv)
FRIENDS_LIST="friend_username_1, friend_username_2"

# Optional: video shared as a rich card, sent SHARE_TIMES times after the text
STREAK_VIDEO_URL="https://www.tiktok.com/@user/video/0000000000000000000"
SHARE_TIMES=2

# Local Browser Visibility: true (headless background) or false (visible window)
HEADLESS=true

# ==========================================
# Notifications (Telegram - Optional)
# ==========================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
